# このファイルを .env にコピーし、実際の値を設定してください（.env はGit管理対象外です）。
# 例: Copy-Item .env.example .env

# 使用するプロバイダー: openai / local / orcarouter
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# ローカルLLM（Ollama）
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=

# OrcaRouter
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=orcarouter/auto
